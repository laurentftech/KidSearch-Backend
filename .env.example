# =============================================================================
# KidSearch - Variables d'environnement
# Copiez ce fichier en .env et adaptez les valeurs.
# ⚠️  NE PAS COMMITER .env DANS GIT
#
# Pour une installation guidée : bash scripts/setup.sh
# =============================================================================

# =============================================================================
# REQUIRED — Variables obligatoires
# =============================================================================

# Clé secrète pour signer les JWT (générer avec : python3 -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change-me-in-production

# Clé d'accès Typesense (utilisée par tous les services)
TYPESENSE_API_KEY=change-me-in-production

# =============================================================================
# AUTHENTICATION — Choisissez UNE méthode
# =============================================================================

# Désactiver l'auth (développement uniquement !)
AUTH_DISABLED=false

# Forcer une méthode : proxy | oidc | google | github | simple
# Laisser vide pour auto-détection selon les variables configurées ci-dessous.
AUTH_PROVIDERS=

# --- Option 1 : Mot de passe simple ---
# DASHBOARD_PASSWORD=mon_mot_de_passe

# --- Option 2 : OIDC (Keycloak, Authentik, Google...) ---
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=kidsearch
# OIDC_CLIENT_SECRET=your_client_secret
# OIDC_REDIRECT_URI=http://localhost:8501/
# OIDC_SCOPES=openid profile email

# --- Option 3 : Proxy authentifiant (Caddy + authcrunch) ---
# AUTH_PROXY_ENABLED=true
# AUTH_PROXY_LOGOUT_URL=/
# AUTH_PROXY_EMAIL_HEADER=X-Token-User-Email
# AUTH_PROXY_NAME_HEADER=X-Token-User-Name

# --- Option 4 : Google OAuth ---
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8501/

# --- Option 5 : GitHub OAuth ---
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:8501/

# Restriction par email, toutes méthodes confondues (optionnel)
# ALLOWED_EMAILS=user1@example.com,user2@example.com

# =============================================================================
# OPTIONAL — Valeurs avec défauts raisonnables en Docker
# =============================================================================

# --- Typesense ---
# En Docker, le défaut du docker-compose.yml est suffisant.
# TYPESENSE_URL=http://typesense:8108
# INDEX_NAME=kidsearch

# --- API ---
# URL interne utilisée par le Dashboard pour parler à l'API
# API_URL=http://kidsearch-all:8080/api
# API_ENABLED=true
# API_WORKERS=2

# --- JWT ---
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION_MINUTES=1440

# --- Embeddings (HuggingFace via service Docker interne) ---
# ⚠️ Ne pas modifier HUGGINGFACE_API_URL en Docker, le défaut interne est optimal.
# EMBEDDING_PROVIDER=huggingface
# HUGGINGFACE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_BATCH_DELAY=2

# Clé Gemini (provider alternatif aux embeddings locaux)
# GEMINI_API_KEY=

# --- Reranking ---
# RERANKING_ENABLED=true
# ⚠️ Ne pas modifier RERANKER_API_URL en Docker.
# RERANKER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# RERANKER_BATCH_SIZE=3
# RERANKER_MAX_CHARS=200
# RERANKER_CACHE_SIZE=4096
# RERANKER_TIMEOUT=12

# --- Poids de fusion des résultats ---
# MEILISEARCH_WEIGHT=0.7
# CSE_WEIGHT=0.3

# --- Google Custom Search Engine (enrichit les résultats) ---
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=

# --- Wiki intégré (Vikidia par défaut) ---
# WIKI_API_URL=https://fr.vikidia.org/w/api.php
# WIKI_SITE_URL=https://fr.vikidia.org/wiki/
# WIKI_SITE_NAME=Vikidia
# WIKI_2_API_URL=https://en.vikidia.org/w/api.php
# WIKI_2_SITE_URL=https://en.vikidia.org/wiki/
# WIKI_2_SITE_NAME=Vikidia EN

# --- URLs de production (affichage dans l'UI) ---
# FRONTEND_URL=https://search.example.com
# DISPLAY_HOST=api.example.com
# DASHBOARD_DISPLAY_HOST=dashboard.example.com
# API_DISPLAY_HOST=api.example.com

# --- Logs ---
# LOG_LEVEL=info