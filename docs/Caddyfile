# Caddyfile exemple pour KidSearch avec authentification AuthCrunch
# Documentation: https://docs.authcrunch.com/

{
    order authenticate before respond
    order authorize before reverse_proxy

    security {
        # Fournisseur OIDC (adapter selon votre provider : Authelia, Authentik, Pocket ID, etc.)
        oauth identity provider my_oidc {
            realm my_oidc
            driver generic
            client_id {env.OIDC_CLIENT_ID}
            client_secret {env.OIDC_CLIENT_SECRET}
            scopes openid email profile
            metadata_url {env.OIDC_ISSUER}/.well-known/openid-configuration
        }

        # Portail d'authentification
        authentication portal auth_portal {
            crypto default token lifetime 3600
            crypto key sign-verify {env.JWT_SHARED_KEY}
            enable identity provider my_oidc
            cookie domain .example.com
            cookie lifetime 86400
        }

        # Politique d'autorisation
        authorization policy admin_policy {
            set auth url https://auth.example.com
            crypto key verify {env.JWT_SHARED_KEY}

            # Injecter les claims JWT comme headers HTTP vers le backend
            inject headers with claims

            acl rule {
                comment allow authenticated users
                match role authp/user
                allow stop log info
            }
            acl rule {
                comment default deny
                match any
                deny log warn
            }
        }
    }
}

# Portail d'authentification
https://auth.example.com {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    route {
        authenticate with auth_portal
    }
}

# Services admin (wildcard avec sous-domaines)
*.internal.example.com {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }

    # KidSearch Admin Dashboard
    @kidsearch-admin host kidsearch-admin.internal.example.com
    handle @kidsearch-admin {
        authorize with admin_policy
        reverse_proxy http://kidsearch-all:8501 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto https
        }
    }

    # Catch-all
    handle {
        respond "Access denied" 403
    }
}
